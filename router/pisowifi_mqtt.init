#!/bin/sh /etc/rc.common
# /etc/init.d/pisowifi_mqtt
# procd service for the PisoWifi MQTT subscriber.
# OpenWrt uses procd (not OpenRC) even on apk-based builds.
#
# Install:
#   ssh root@10.0.0.1 'cat > /etc/init.d/pisowifi_mqtt' < pisowifi_mqtt.init
#   ssh root@10.0.0.1 'chmod +x /etc/init.d/pisowifi_mqtt'
#   /etc/init.d/pisowifi_mqtt enable
#   /etc/init.d/pisowifi_mqtt start

START=95
STOP=10

USE_PROCD=1

PROG="/usr/bin/pisowifi_mqtt_subscriber.sh"

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    return 0
}
