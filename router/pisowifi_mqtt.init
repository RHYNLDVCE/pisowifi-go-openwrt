#!/sbin/openrc-run
# /etc/init.d/pisowifi_mqtt
# OpenRC service for the PisoWifi MQTT subscriber.
# Used on OpenWrt 24.x (apk-based, OpenRC init system).
#
# Install:
#   scp pisowifi_mqtt.init root@10.0.0.1:/etc/init.d/pisowifi_mqtt
#   chmod +x /etc/init.d/pisowifi_mqtt
#   rc-update add pisowifi_mqtt
#   rc-service pisowifi_mqtt start

description="PisoWifi MQTT subscriber — enforces nftables rules from Orange Pi commands"

PROG="/usr/bin/pisowifi_mqtt_subscriber.sh"
PIDFILE="/var/run/pisowifi_mqtt.pid"
LOGFILE="/var/log/pisowifi_mqtt.log"

depend() {
    need net mosquitto
    after firewall
}

start() {
    ebegin "Starting PisoWifi MQTT subscriber"
    start-stop-daemon --start \
        --background \
        --make-pidfile \
        --pidfile "$PIDFILE" \
        --stdout "$LOGFILE" \
        --stderr "$LOGFILE" \
        --exec /bin/sh -- "$PROG"
    eend $?
}

stop() {
    ebegin "Stopping PisoWifi MQTT subscriber"
    start-stop-daemon --stop \
        --pidfile "$PIDFILE"
    eend $?
}
