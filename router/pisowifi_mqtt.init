#!/bin/sh /etc/rc.common
# /etc/init.d/pisowifi_mqtt
# OpenWrt init.d service for the PisoWifi MQTT subscriber.
#
# Install:
#   cp pisowifi_mqtt.init /etc/init.d/pisowifi_mqtt
#   chmod +x /etc/init.d/pisowifi_mqtt
#   /etc/init.d/pisowifi_mqtt enable
#   /etc/init.d/pisowifi_mqtt start

START=95
STOP=10

USE_PROCD=1

PROG="/usr/bin/pisowifi_mqtt_subscriber.sh"
LOGFILE="/var/log/pisowifi_mqtt.log"

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 0  # respawn if it dies: threshold=3600s, timeout=5s, retry=forever
    procd_close_instance
}

stop_service() {
    # procd handles the kill; nothing extra needed
    return 0
}
