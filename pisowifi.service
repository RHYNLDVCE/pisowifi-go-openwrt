[Unit]
Description=PisoWifi Golang Service
Wants=network-online.target
After=network.target network-online.target

[Service]
User=root
# Ensure this matches the exact path of your folder on the Orange Pi
WorkingDirectory=/srv/pisowifi-go-openwrt

# Run the compiled Go binary
ExecStart=/srv/pisowifi-go-openwrt/pisowifi-server

# Restart on crash, but wait 5s to prevent CPU spam during boot loops
Restart=always
RestartSec=5
TimeoutStopSec=3

# The Go backend automatically triggers fail_safe.sh on shutdown, 
# but we leave this here as a hard fallback if it crashes unexpectedly.
ExecStopPost=/srv/pisowifi-go-openwrt/fail_safe.sh

[Install]
WantedBy=multi-user.target