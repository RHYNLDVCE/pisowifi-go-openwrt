# PisoWifi Environment Variables
# IMPORTANT: Keep this file secret. Do not commit to git.

SECRET_KEY=change_this_to_a_long_random_secret_key_before_deploying
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Network Interfaces — these are the ROUTER'S interface names (not the Orange Pi's).
# The Orange Pi sends these to the router via MQTT so the router can set up nftables.
# Run `ip link show` on the ROUTER to confirm.
LAN_INTERFACE=br-lan
WAN_INTERFACE=eth1

# MQTT Broker — runs on the OpenWrt router (10.0.0.1)
# The Orange Pi publishes allow/block commands; the router subscriber enforces them.
MQTT_BROKER=tcp://10.0.0.1:1883
MQTT_CLIENT_ID=pisowifi-orangepi
MQTT_USERNAME=pisowifi
MQTT_PASSWORD=change_this_mqtt_password